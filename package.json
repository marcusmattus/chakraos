{
  "name": "bilt-starter",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:go:tunnel": "bash scripts/start-expo-go.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "expo-check": "expo install --check --npm",
    "eas:configure": "eas build:configure",
    "eas:sync-submit": "node scripts/sync-eas-submit-config.mjs",
    "eas:build:dev": "npm run eas:doctor && eas build --profile development --platform all --non-interactive",
    "eas:build:preview": "npm run eas:doctor && eas build --profile preview --platform all --non-interactive",
    "eas:build:production": "npm run eas:doctor && npm run eas:sync-submit && eas build --profile production --platform all --non-interactive",
    "eas:submit": "npm run eas:sync-submit && eas submit --profile production --platform all --latest --non-interactive",
    "eas:build:submit": "npm run eas:doctor && npm run eas:sync-submit && eas build --profile production --platform all --auto-submit --non-interactive",
    "eas:update:preview": "eas update --channel preview --non-interactive",
    "lint": "oxlint --type-aware --type-check",
    "lint:css": "node scripts/lint-css.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eas:doctor": "node -e \"require('fs').accessSync('eas.json'); console.log('eas.json OK')\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "~0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/config": "^57.0.0",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.2",
    "babel-plugin-inline-import": "~3.0.0",
    "babel-preset-expo": "~57.0.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "date-fns": "^4.4.0",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "heroui-native": "^1.0.3",
    "lucide-react-native": "^0.562.0",
    "pigeon-maps": "^0.22.1",
    "posthog-js": "^1.360.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "~7.76.1",
    "react-native": "0.86.3",
    "react-native-css-interop": "~0.2.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "uniwind": "^1.7.0",
    "zod": "~4.4.3",
    "zustand": "~5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/runtime": "~7.28.6",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^25.9.5",
    "@types/react": "~19.2.4",
    "babel-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "eas-cli": "^16.32.0",
    "eslint-plugin-expo": "^1.0.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-native": "^5.0.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "tailwindcss": "^4.3.0",
    "tsx": "~4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.9.0"
}
